<ci:ComponentBase
    x:Class="DutyRoster.Components.DutyDisplayComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core">

  <ci:ComponentBase.Content>
    <Grid Name="Root" VerticalAlignment="Center">
      <StackPanel Name="StackRoot" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14" />
      <TextBlock Name="EmptyText"
                 IsVisible="False"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 FontSize="14"
                 VerticalAlignment="Center" />
    </Grid>
  </ci:ComponentBase.Content>

</ci:ComponentBase>
