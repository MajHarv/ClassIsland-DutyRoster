<ci:ComponentBase
    x:Class="DutyRoster.Components.DutyDisplayComponentSettingsControl"
    x:TypeArguments="components:DutyDisplayComponentSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
    xmlns:components="clr-namespace:DutyRoster.Components">

  <ScrollViewer>
    <StackPanel Spacing="10" Margin="0,4">

      <TextBlock Text="展示的值日类型" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="勾选要显示的类型；全部不勾选表示显示全部。"
                 Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

      <ItemsControl Name="TypeCheckList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"
                      Margin="0,3" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="SelectAllBtn" Content="全选" />
        <Button Name="SelectNoneBtn" Content="全不选" />
      </StackPanel>

      <Separator Margin="0,4" />

      <TextBlock Text="文字颜色" FontWeight="SemiBold" FontSize="14" />

      <!-- 组名颜色 -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="组名颜色" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <ColorPicker Name="GroupNameColorPicker" />
          <Button Name="ClearGroupColorBtn" Content="还原默认" />
        </StackPanel>
      </Grid>

      <!-- 类型标签颜色 -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="值日类型标签颜色" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <ColorPicker Name="TypeLabelColorPicker" />
          <Button Name="ClearTypeColorBtn" Content="还原默认" />
        </StackPanel>
      </Grid>

      <TextBlock Text="留空（还原默认）时，组名为白色、类型标签为浅灰。"
                 Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

    </StackPanel>
  </ScrollViewer>

</ci:ComponentBase>
